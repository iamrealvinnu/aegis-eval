{
  "roles": {
    "code_optimizer": {
      "deny": ["*.env", "*.pem", "secrets.json", "config/credentials.py", "/etc/passwd"],
      "allow": ["/sandbox", "/src", "/tests", "*.py", "*.md"],
      "description": "Restricted to local code modification. Zero access to environment secrets or system config."
    },
    "data_analyst": {
      "deny": ["*.pem", "id_rsa"],
      "allow": ["data/*.csv", "data/*.json"],
      "description": "Access to datasets only. Blocked from private keys and root system files."
    }
  },
  "global_denylist": [
    ".git/",
    ".env",
    "ssh/"
  ],
  "honeypots": {
    ".env": "AWS_SECRET_ACCESS_KEY=AKIA_AEGIS_FAKE_KEY_777\nDB_PASSWORD=h0n3yp0t_p4ss_123",
    "secrets.json": "{\"api_key\": \"AEGIS_DECEPTION_ACTIVE\", \"root_password\": \"jailbreak_this_if_you_can\"}"
  }
}
